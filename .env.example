CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_SECRET_KEY=sk_test_replace_me
CLERK_WEBHOOK_SIGNING_SECRET=whsec_replace_me
CLERK_ACCOUNT_PORTAL_URL=https://your-instance.accounts.dev
PUBLIC_URL=http://localhost:3000
PORT=3000
FALKORDB_HOST=127.0.0.1
FALKORDB_PORT=6379
FALKORDB_PASSWORD=replace_me
FALKORDB_GRAPH=shared_memory

FALKORDB_MEMORY_GRAPH=shared_memory_app

# Semantic search: vectors and full-text indexes remain in FalkorDB.
# Configure a personal key privately; never paste keys into chat or commit them.
EMBEDDING_PROVIDER=disabled
OPENROUTER_API_KEY=
# Optional alternative: EMBEDDING_PROVIDER=gemini with GEMINI_API_KEY.
GEMINI_API_KEY=
# Optional comma-separated provider routes to exclude on OpenRouter.
EMBEDDING_OPENROUTER_IGNORE=

# Automatic entity/relationship extraction on remember and revise_memory.
# Separate from embeddings; requires the personal OpenRouter key above.
ONTOLOGY_PROVIDER=disabled
ONTOLOGY_MODEL=openai/gpt-4.1-mini
ONTOLOGY_OPENROUTER_IGNORE=
