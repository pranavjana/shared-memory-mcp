{
  "name": "shared-memory-mcp",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22 <27"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env.local --import tsx src/index.ts",
    "build": "tsc && vite build",
    "start": "node --env-file-if-exists=.env.local dist/index.js",
    "test": "node --import tsx --test test/*.test.ts",
    "build:server": "tsc",
    "dev:web": "vite",
    "check:web": "tsc -p tsconfig.web.json",
    "test:graph": "node --import tsx --test test/memory.integration.ts test/ontology-extraction.integration.ts test/shared-updates.integration.ts test/shared-ontology.integration.ts test/provisional-predicates.integration.ts test/ontology-e2e.integration.ts test/space-members.integration.ts test/space-search.integration.ts test/personal-watch.integration.ts test/sandbox-demo-ontology.integration.ts test/graph-demo.integration.ts",
    "sandbox:seed": "node scripts/sandbox-seed.mjs",
    "sandbox:demo-ontology": "node scripts/sandbox-demo-ontology.mjs",
    "graph:demo": "node --import tsx scripts/graph-demo.ts"
  },
  "dependencies": {
    "@clerk/express": "^2.1.78",
    "@clerk/mcp-tools": "^0.6.0",
    "@clerk/react": "^6.17.8",
    "@dagrejs/dagre": "^3.1.1",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@xyflow/react": "^12.12.0",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "falkordb": "^6.8.0",
    "helmet": "^8.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/cors": "^2.8.19",
    "@types/dagre": "^0.7.54",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "prettier": "^3.9.10",
    "svix": "^2.8.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
